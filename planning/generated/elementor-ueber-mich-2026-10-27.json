         "settings": {
          "content_width": "full",
          "editor": "<ul>\n<li>Webseiten für Handwerker, Kuriere, Autoren u. a.</li>\n<li>Rezepteverwaltung für ein Lebensmittelkonzern</li>\n<li>Online-Shop für eine Brennerei</li>\n</ul>"
