       "elements": [
        {
         "id": "6a684b3",
         "settings": {
          "editor": "<ul>\n<li>Patientenumfrage-App für eine klinische Versorgungsstudie</li>\n<li>Entwickelt mit Flutter</li>\n</ul>"
         },
         "elements": [],
