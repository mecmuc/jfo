      {
       "id": "b8062b6",
       "elType": "widget",
       "widgetType": "text-editor",
       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p><strong>Problem:</strong> Ihre App soll klüger werden, aber Kundendaten dürfen das Gerät nicht verlassen, und Cloud-KI kostet pro Anfrage.</p>"
       }
      },
      {
       "id": "3b8b4e3",
       "elType": "widget",
       "widgetType": "text-editor",
       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p><strong>Lösung:</strong> iPhone- und iPad-Apps mit Apple Intelligence: KI läuft direkt auf dem Gerät, datenschutzfreundlich und ohne laufende Kosten pro Anfrage. Ihre App wird über Siri und Kurzbefehle erreichbar. Grundlage sind über 10 Jahre native iOS-Entwicklung.</p>"
       }
      }
