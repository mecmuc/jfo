       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p>Sostengo volentieri progetti del cuore con siti web, app o altri software. Finora soprattutto negli ambiti della Comunicazione Nonviolenta, della mindfulness e della terapia.</p>"
       }
      },
      {
       "id": "fe37c6c",
       "elType": "widget",
       "widgetType": "text-editor",
       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p><strong>Esempio:</strong> il „GFK-Spiel“, un gioco didattico sulla Comunicazione Nonviolenta, come app per iOS e Android, con oltre 10.000 installazioni.</p><blockquote class=\"wp-block-quote\"><p><em>„Un’app molto utile, chiara e bella. Grazie di cuore!“</em></p><p>(tradotto dal tedesco)</p></blockquote>"
       }
      }
