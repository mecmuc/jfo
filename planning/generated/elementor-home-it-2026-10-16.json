      {
       "id": "264f360",
       "elType": "widget",
       "widgetType": "text-editor",
       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p><strong>Problema:</strong> La Sua app deve diventare più intelligente, ma i dati dei clienti non devono lasciare il dispositivo, e l’IA nel cloud costa a ogni richiesta.</p>"
       }
      },
      {
       "id": "daa3cc1",
       "elType": "widget",
       "widgetType": "text-editor",
       "elements": [],
       "isInner": false,
       "settings": {
        "editor": "<p><strong>Soluzione:</strong> App per iPhone e iPad con Apple Intelligence: l’IA funziona direttamente sul dispositivo, nel rispetto della privacy e senza costi continui per ogni richiesta. La Sua app diventa raggiungibile tramite Siri e Comandi rapidi. Alla base ci sono oltre 10 anni di sviluppo iOS nativo.</p>"
       }
      }
